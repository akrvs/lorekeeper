# Copy to `.env` and fill in. docker-compose reads this file.
# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
POSTGRES_USER=brain
POSTGRES_PASSWORD=brain
POSTGRES_DB=company_brain
# Host as seen from the API process. Inside docker-compose this is overridden
# to `db`. For running the app on your host against the compose DB, use localhost.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Exposed API port on the host
API_PORT=8000

# ----------------------------------------------------------------------------
# Embeddings — the vector column dimension is fixed at table-create time.
# 1536 = text-embedding-3-small. Use 3072 for text-embedding-3-large.
# Changing this after first run requires a migration.
# ----------------------------------------------------------------------------
EMBEDDING_DIM=1536

# ----------------------------------------------------------------------------
# Azure OpenAI (extraction + embeddings). Use LLM_PROVIDER=stub for offline dev.
# Structured outputs need api-version >= 2024-08-01 and a capable chat deployment.
# ----------------------------------------------------------------------------
LLM_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o

# ----------------------------------------------------------------------------
# GitHub connector (Step 4). PAT scopes: repo contents/PRs/issues read.
# GITHUB_REPO is the default target if --repo / ?repo= is omitted.
# ----------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_REPO=owner/name

# ----------------------------------------------------------------------------
# Slack connector (Step 4). Bot token (xoxb-...) scopes:
# channels:history, channels:read, users:read. Invite the bot to the channel.
# SLACK_CHANNEL_ID is the default target if --channel / ?channel_id= is omitted.
# ----------------------------------------------------------------------------
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=C0123456789

# ----------------------------------------------------------------------------
# HTTP resilience / ingestion limits (sane defaults; override if needed)
# ----------------------------------------------------------------------------
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=5
HTTP_BACKOFF_BASE_SECONDS=1
HTTP_BACKOFF_MAX_SECONDS=60
INGEST_MAX_ITEMS=200
EXTRACTION_MAX_CHARS=12000

# ============================================================================
# Phase 7 — Enterprise hardening
# ============================================================================

# --- Security / RBAC (Track 1) ----------------------------------------------
# Default OFF: every caller is an unrestricted superuser (open-source MVP).
# Turn ON to row-filter every MCP tool by the caller's granted data sources.
RBAC_ENABLED=false
OIDC_JWKS_URL=
OIDC_AUDIENCE=
OIDC_ISSUER=

# --- Performance (Track 3) --------------------------------------------------
EMBEDDING_BATCH_SIZE=256
TRAVERSE_STATEMENT_TIMEOUT_MS=2000
TRAVERSE_MAX_DEPTH=4
TRAVERSE_MAX_RESULTS=50
CACHE_BACKEND=memory          # memory | redis
CACHE_TTL_SECONDS=60
REDIS_URL=redis://redis:6379/0

# --- Connectors (Track 4) ---------------------------------------------------
LOCAL_ROOT=/vault
LOCAL_SCAN_CONCURRENCY=16
NOTION_TOKEN=
NOTION_DATABASE_ID=
TEAMS_TENANT_ID=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_TEAM_ID=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
GMEET_CREDENTIALS_JSON=

# ----------------------------------------------------------------------------
# Proposals / self-maintenance
# ----------------------------------------------------------------------------
# Proposals at/above this confidence auto-apply (still audited + reversible).
# Leave unset to queue everything for human review (the default).
#PROPOSAL_AUTO_APPLY_THRESHOLD=0.95
